# =====================================================================
# Blogger Auto-Pilot SaaS - Production Environment Configuration
# Template resmi untuk deployment publik (Cloud VPS / Docker / PaaS)
# =====================================================================

# --- Lingkungan Operasi & Keamanan Session ---
ENVIRONMENT=production
SECURE_COOKIES=true
PORT=8090
HOST=0.0.0.0
APP_BASE_URL=https://app.namadomainanda.com

# --- Database Multi-Tenant Produksi (Supabase / Managed PostgreSQL) ---
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:GANTI_DENGAN_PASSWORD_DB_ANDA@db.projectref.supabase.co:5432/postgres

# --- Kunci Kriptografi & Token Keamanan (Wajib diganti!) ---
# Buat string acak minimal 32 karakter (contoh via: openssl rand -hex 32)
JWT_SECRET_KEY=ganti_dengan_jwt_secret_acak_panjang_minimal_32_karakter_produksi
ENCRYPTION_SECRET_KEY=ganti_dengan_aes_256_secret_key_untuk_enkripsi_token_google

# --- Google Blogger OAuth 2.0 (Platform Centralized App) ---
# Letakkan file client_secret.json di root direktori proyek, atau arahkan path-nya di sini:
GOOGLE_CLIENT_SECRETS_FILE=client_secret.json

# --- Mesin AI Konten (Primary: Gemini Flash | Fallback: Groq LLaMA 3.3) ---
# Dapatkan gratis dari Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy_GANTI_DENGAN_GEMINI_KEY_ANDA

# Dapatkan gratis dari Groq Console: https://console.groq.com/
GROQ_API_KEY=gsk_GANTI_DENGAN_GROQ_KEY_ANDA

# Opsional: OpenAI GPT-4o-mini
# OPENAI_API_KEY=sk-proj-GANTI_JIKA_INGIN_OPENAI

# --- CDN Gambar Artikel Publik (Cloudinary Free 25GB/Bulan) ---
# Dapatkan gratis dari https://cloudinary.com/
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://123456789012345:abcdefghijklmnopqrstuvwxyza@namacloudanda

# --- Payment Gateway Rupiah (Midtrans Production) ---
# Dapatkan dari https://dashboard.midtrans.com/settings/access_keys (Mode Production)
MIDTRANS_SERVER_KEY=Mid-server-GANTI_DENGAN_PRODUCTION_SERVER_KEY
MIDTRANS_CLIENT_KEY=Mid-client-GANTI_DENGAN_PRODUCTION_CLIENT_KEY
MIDTRANS_IS_PRODUCTION=true

# --- Autopilot Background Scheduler Daemon ---
# Interval siklus autopilot dalam detik (3600 = 1 jam sekali)
SCHEDULER_INTERVAL_SECONDS=3600
