# Blogger Auto-Pilot & Multi-Blog Dashboard Configuration

# Server Host & Port
PORT=8090
HOST=0.0.0.0

# Database and storage paths (defaults to current directory if unset)
# BLOGGER_DB_PATH=data.db
# BLOGGER_CONFIG_FILE=config.json
# BLOGGER_UPLOADS_DIR=uploads
# GOOGLE_TOKEN_FILE=token.json
# GOOGLE_CLIENT_SECRETS_FILE=client_secret.json

# Optional: AI Provider API Key for autonomous content generation
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: Cloudinary Public Image CDN (Free 25GB/mo - eliminates broken images on live Blogger)
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Atau dipisah:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- SaaS Multi-Tenant & Supabase Database ---
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# JWT_SECRET_KEY=ganti-dengan-kunci-rahasia-panjang-min-32-karakter-keamanan-tinggi
# ENCRYPTION_SECRET_KEY=kunci-aes-256-untuk-enkripsi-oauth-token-blogger

# --- Midtrans Indonesian Payment Gateway ---
# Dapatkan dari dashboard Midtrans (https://dashboard.midtrans.com/settings/access_keys)
# MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxx
# MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxx
# MIDTRANS_IS_PRODUCTION=false

